{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piping-design-skill.local/schemas/evidence.json",
  "title": "Piping Evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "enum": ["photo", "sketch", "pid", "cad", "document", "user", "inference", "tool"]},
    "source_id": {"type": "string"},
    "region": {
      "type": "array",
      "prefixItems": [
        {"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "method": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "note": {"type": "string"}
  },
  "required": ["id", "source", "confidence"]
}
